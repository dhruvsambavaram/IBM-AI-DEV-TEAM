# Environment Variables — AI Dev Team
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# ---- Groq API ----------------------------------------------------------------
# Your Groq API key (get one at https://console.groq.com)
GROQ_API_KEY=gsk_your_
# Working models on the free tier (as of 2025):
#   openai/gpt-oss-20b  — reliable, smaller, recommended
#   openai/gpt-oss-120b — larger but may hit token limits
GROQ_MODEL=openai/gpt-oss-20b
